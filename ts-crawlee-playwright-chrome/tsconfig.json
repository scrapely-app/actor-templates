{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": ["DOM"],
        "outDir": "dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "noUnusedLocals": false,
        "skipLibCheck": true
    },
    "include": ["./src/**/*"]
}
